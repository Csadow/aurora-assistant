{
  "name": "aurora-assistant",
  "version": "1.157.0",
  "private": true,
  "main": "desktop/main.mjs",
  "type": "module",
  "description": "A local personal assistant with an Obsidian-compatible Markdown memory",
  "engines": {"node": ">=24"},
  "scripts": {
    "mobile:build": "python3 scripts/build-mobile.py",
    "mobile:preview": "node scripts/mobile-preview.mjs",
    "test:mobile": "node tests/mobile.test.mjs && node scripts/mobile-browser-test.mjs",
    "start": "node scripts/start-desktop.mjs",
    "start:web": "node scripts/start.mjs",
    "install:speech": "node scripts/install-speech.mjs",
    "install:desktop": "node scripts/install-desktop.mjs",
    "test:recovery-workspace:desktop": "node scripts/test-recovery-workspace-desktop.mjs",
    "test:planning-week:desktop": "node scripts/test-planning-week-desktop.mjs",
    "test:reminder-cleanup:desktop": "node scripts/test-reminder-cleanup-desktop.mjs",
    "test:reminder-overview:desktop": "node scripts/test-reminder-overview-desktop.mjs",
    "test:reminder-plan:desktop": "node scripts/test-reminder-plan-desktop.mjs",
    "test:workload-reminders:desktop": "node scripts/test-workload-revisit-desktop.mjs",
    "test:desktop": "node scripts/test-desktop.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node scripts/browser-test.mjs",
    "test:planner-attention:live": "node scripts/planner-attention-live-test.mjs",
    "test:planner-attempt:live": "node scripts/task-attempt-live-test.mjs",
    "test:planner-workflow:live": "node scripts/task-workflow-live-test.mjs",
    "test:planner:live": "node scripts/task-projects-live-test.mjs",
    "test:live": "node scripts/live-test.mjs",
    "doctor": "node scripts/doctor.mjs",
    "backup": "node scripts/backup.mjs",
    "recovery": "python3 scripts/recovery.py create",
    "test:checkpoints:live": "node scripts/project-checkpoint-live-test.mjs",
    "test:projects:live": "node scripts/task-acceptance.mjs --live --workspace",
    "test:continuity:live": "node scripts/task-acceptance.mjs --live --continuity",
    "test:followup:live": "node scripts/workflow-followup-live-test.mjs",
    "test:suggestions:live": "node scripts/workflow-suggestions-live-test.mjs",
    "test:requirements:live": "node scripts/task-acceptance.mjs --live --requirements",
    "test:skills:live": "node scripts/task-skills-live-test.mjs",
    "test:workflows:live": "node scripts/workflow-live-test.mjs",
    "test:chatgpt-project:live": "node scripts/chatgpt-project-live-test.mjs --live",
    "test:laptop:recovery": "node scripts/laptop-recovery-test.mjs",
    "test:laptop:recovery:live": "node scripts/laptop-recovery-test.mjs --live",
    "test:laptop:live": "node scripts/laptop-task-live-test.mjs",
    "test:repair-review": "node scripts/repair-review-eval.mjs --preflight",
    "test:repair-review:live": "node scripts/repair-review-eval.mjs --live",
    "test:repair-copies": "node scripts/repair-copy-eval.mjs --run",
    "test:copy-actions": "node scripts/test-copy-live.mjs --preflight",
    "test:copy-actions:live": "node scripts/test-copy-live.mjs --live",
    "test:project-copies": "node scripts/project-copy-live.mjs --preflight",
    "test:project-copies:live": "node scripts/project-copy-live.mjs --live",
    "test:quality": "node scripts/workflow-quality.mjs",
    "test:quality:live": "node scripts/workflow-quality.mjs --live",
    "test:acceptance": "node scripts/task-acceptance.mjs",
    "test:acceptance:live": "node scripts/task-acceptance.mjs --live",
    "test:tasks": "node --test --test-timeout=30000 tests/task-execution.test.mjs",
    "test:steering:live": "node scripts/task-steering-live-test.mjs",
    "test:document:live": "node scripts/document-open-live-test.mjs",
    "test:help:live": "node scripts/workflow-help-live-test.mjs",
    "test:models": "node scripts/compare-task-models.mjs"
  }
}
